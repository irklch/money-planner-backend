  "components": {
    "schemas": {
      "AnonymousRequest": {
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ],
            "title": "Platform"
          },
          "appVersion": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Appversion"
          }
        },
        "type": "object",
        "required": [
          "platform",
          "appVersion"
        ],
        "title": "AnonymousRequest"
      },
      "AuthSession": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid"
          },
          "isAnonymous": {
            "type": "boolean",
            "title": "Isanonymous"
          },
          "accessToken": {
            "type": "string",
            "title": "Accesstoken"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Accesstokenexpiresat"
          },
          "refreshToken": {
            "type": "string",
            "title": "Refreshtoken"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Refreshtokenexpiresat"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "isAnonymous",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ],
        "title": "AuthSession"
      },
      "AveragesOut": {
        "properties": {
          "accountedDays": {
