{
  "openapi": "3.1.0",
  "info": {
    "title": "Money Planner API",
    "description": "Контракт для iOS и будущего Android-клиента. Даты — YYYY-MM-DD, суммы — decimal-строки с 2 знаками (RUB). Все запросы, кроме /auth/*, — с Authorization: Bearer <accessToken> (гостевой токен устройства из POST /v1/auth/guest). Ошибки — единый формат { error: { code, message, status, retryable, requestId, details } }.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/auth/guest": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create Guest Session",
        "operationId": "create_guest_session_v1_auth_guest_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestSession"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_request`. Заголовки: Idempotency-Key — отсутствует или не UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "`idempotency_key_reused`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited` (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error` (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "`service_unavailable` (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh Session",
        "operationId": "refresh_session_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestSession"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "`refresh_token_invalid` · `session_revoked` · `account_deleted`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited` (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error` (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "`service_unavailable` (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/imports/parse": {
      "post": {
        "tags": [
          "imports"
        ],
        "summary": "Parse Statement",
        "operationId": "parse_statement_v1_imports_parse_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "type": "object",
                "required": [
                  "file"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResult"
                }
              }
            }
          },
          "401": {
            "description": "`token_expired` (retryable) · `access_token_invalid`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "`file_too_large`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "`unsupported_format`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`corrupted_file` · `unknown_bank` · `empty_statement` · `income_only`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited` (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "`processing_failed` (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "`service_unavailable` (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BankOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "title": "BankOut"
      },
      "GuestSession": {
        "properties": {
          "subjectKind": {
            "type": "string",
            "const": "guest",
            "title": "Subjectkind",
            "default": "guest"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "title": "Deviceid"
          },
          "accessToken": {
            "type": "string",
            "title": "Accesstoken"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Accesstokenexpiresat"
          },
          "refreshToken": {
            "type": "string",
            "title": "Refreshtoken"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Refreshtokenexpiresat"
          }
        },
        "type": "object",
        "required": [
          "deviceId",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ],
        "title": "GuestSession"
      },
      "GuestSessionRequest": {
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ],
            "title": "Platform"
          },
          "appVersion": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Appversion"
          }
        },
        "type": "object",
        "required": [
          "platform",
          "appVersion"
        ],
        "title": "GuestSessionRequest"
      },
      "ParseResult": {
        "properties": {
          "bank": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BankOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "period": {
            "$ref": "#/components/schemas/PeriodOut"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/ParsedOperation"
            },
            "type": "array",
            "title": "Operations"
          },
          "skippedIncomeCount": {
            "type": "integer",
            "title": "Skippedincomecount"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/PartiallyReadWarning"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "bank",
          "period",
          "operations",
          "skippedIncomeCount",
          "warnings"
        ],
        "title": "ParseResult"
      },
      "ParsedOperation": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "title": "Amount",
            "example": "1250.00"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "categoryId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Categoryid"
          },
          "categoryStatus": {
            "type": "string",
            "enum": [
              "assigned",
              "suggested",
              "unassigned"
            ],
            "title": "Categorystatus"
          }
        },
        "type": "object",
        "required": [
          "date",
          "amount",
          "comment",
          "categoryId",
          "categoryStatus"
        ],
        "title": "ParsedOperation"
      },
      "PartiallyReadWarning": {
        "properties": {
          "code": {
            "type": "string",
            "const": "partially_read",
            "title": "Code",
            "default": "partially_read"
          },
          "unreadDates": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Unreaddates"
          },
          "unreadRowCount": {
            "type": "integer",
            "title": "Unreadrowcount"
          }
        },
        "type": "object",
        "required": [
          "unreadDates",
          "unreadRowCount"
        ],
        "title": "PartiallyReadWarning"
      },
      "PeriodOut": {
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "title": "From"
          },
          "to": {
            "type": "string",
            "format": "date",
            "title": "To"
          }
        },
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "title": "PeriodOut"
      },
      "RefreshRequest": {
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 256,
            "minLength": 16,
            "title": "Refreshtoken"
          }
        },
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "title": "RefreshRequest"
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "description": "Индекс элемента массива (импорт)"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "status",
              "retryable",
              "requestId",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "access_token_invalid",
                  "account_deleted",
                  "category_archived",
                  "category_name_taken",
                  "category_not_found",
                  "category_readonly",
                  "corrupted_file",
                  "day_has_expenses",
                  "empty_statement",
                  "expense_not_found",
                  "file_too_large",
                  "idempotency_in_progress",
                  "idempotency_key_reused",
                  "income_only",
                  "insights_unavailable",
                  "internal_error",
                  "invalid_request",
                  "method_not_allowed",
                  "not_found",
                  "payload_too_large",
                  "processing_failed",
                  "rate_limited",
                  "refresh_token_invalid",
                  "service_unavailable",
                  "session_revoked",
                  "token_expired",
                  "unknown_bank",
                  "unsupported_format",
                  "validation_failed"
                ]
              },
              "message": {
                "type": "string",
                "description": "Только для логов, не показывать"
              },
              "status": {
                "type": "integer"
              },
              "retryable": {
                "type": "boolean"
              },
              "requestId": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
