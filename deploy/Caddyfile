{$API_DOMAIN} {
	encode gzip
	# Лимит тела: файл выписки 10 МБ + multipart overhead (backend проверяет точный лимит сам)
	request_body {
		max_size 11MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# Без access-логов Caddy: в URL есть query (периоды), а логи приложения уже есть.
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}
