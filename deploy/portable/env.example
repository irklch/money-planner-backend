# Шаблон deploy/portable/.env. Скопируйте: cp env.example .env && chmod 600 .env
# Значения секретов не коммитятся и не пересылаются в чатах. Копия .env хранится у владельца
# в менеджере паролей (docs/disaster-recovery.md, «Что хранить вне сервера»).

# --- Сервер ---
# public — запускать Caddy (HTTPS для API_DOMAIN). На тестовом стенде без домена — пусто.
COMPOSE_PROFILES=public
# Домен API, на который смотрит iOS-приложение. A-запись → публичный IP сервера, TTL 300.
API_DOMAIN=
# Публичный IPv4 этого сервера. Должен совпадать с A-записью API_DOMAIN, иначе api не стартует.
FENCE_EXPECTED_IP=
# enforce — штатно; off — только для проверки нового сервера до переключения DNS.
FENCE_MODE=enforce
# Имя сервера в путях резервных копий: mp-<провайдер>-<n>, например mp-selectel-1.
INSTANCE_NAME=
LOG_LEVEL=INFO

# --- Секреты приложения (openssl rand -base64 48, каждый свой) ---
POSTGRES_PASSWORD=
JWT_SECRET=
TOKEN_DERIVATION_SECRET=

# --- ИИ (необязательно) ---
# false — импорт работает без ИИ: нераспознанные операции уходят на ручную проверку.
AI_ENABLED=false
# Yandex AI Studio доступен по API-ключу сервисного аккаунта и вне Yandex Cloud.
# AI_FOLDER_ID=
# AI_API_KEY=
# AI_MODEL_CATEGORIZE=gpt://<folder-id>/yandexgpt-lite/latest
# AI_MODEL_INSIGHTS=gpt://<folder-id>/yandexgpt/latest

# --- Резервные копии ---
# Публичный ключ age (строка age1...). Приватный ключ на сервер НЕ кладётся.
BACKUP_AGE_RECIPIENT=
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP_LOCAL_DAYS=3
BACKUP_KEEP_REMOTE_DAYS=35
# Путь rclone к хранилищу вне Yandex Cloud: <remote>:<bucket>/<prefix>. Пусто — копии только на сервере.
BACKUP_REMOTE=offsite:money-planner-backups/db
# Описание remote "offsite" (S3-совместимое хранилище другого провайдера). Ключ — только на запись
# в этот бакет, если провайдер это позволяет; бакет с версионированием или блокировкой удаления.
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_REGION=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
