ENV=dev
LOG_LEVEL=INFO

# YDB (новый backend, E1). Без YDB_ENDPOINT слой YDB не подключается.
# Локально: docker compose up -d ydb. В prod: grpcs://... и YDB_AUTH=metadata.
# YDB_ENDPOINT=grpc://localhost:2136
# YDB_DATABASE=/local
# YDB_AUTH=anonymous
# YDB_TABLE_PREFIX=mp
# YDB_POOL_SIZE=2

# Параметры обработки импорта (план §6.3) — значения по умолчанию, меняются без релиза:
# IMPORT_MAX_FILE_BYTES=2097152
# IMPORT_MAX_OPERATIONS=5000
# IMPORT_PARSE_TIMEOUT_S=30
# IMPORT_RATE_PER_MINUTE=5
# IMPORT_RATE_PER_DAY=10
# IMPORT_CONCURRENCY_PER_DEVICE=1
# IMPORT_CONCURRENCY_PER_INSTANCE=4
# IMPORT_UNCONFIRMED_MAX=3
# IMPORT_FREE_LIMIT=3
# ENFORCE_QUOTAS=false
# AI_CATEGORIZATION_ENABLED=true
# AI_MAX_DESCRIPTIONS_PER_IMPORT=500
# GUEST_CREATE_RATE_PER_IP=10

DATABASE_URL=postgresql+asyncpg://money:money@localhost:5432/money
# DB_SSL_ROOT_CERT=/certs/yandex-root.crt
JWT_SECRET=dev-only-change-me-dev-only-change-me
TOKEN_DERIVATION_SECRET=dev-only-derivation-secret-change-me
REFRESH_TOKEN_TTL_DAYS=365

AI_ENABLED=false
# AI_FOLDER_ID=b1g...
# AI_API_KEY=...
# AI_USE_METADATA_IAM=true
# AI_MODEL_CATEGORIZE=gpt://<folder-id>/yandexgpt-lite/latest
# AI_MODEL_INSIGHTS=gpt://<folder-id>/yandexgpt/latest

# В проде секреты приходят из Lockbox:
# LOCKBOX_SECRET_ID=e6q...
